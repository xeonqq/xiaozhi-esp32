{
    "type": "esp32-phoniebox",
    "target": "esp32",
    "builds": [
        {
            "name": "esp32-phoniebox",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X64=y"
            ]
        },
        {
            "name": "esp32-phoniebox-sh1106",
            "sdkconfig_append": [
                "CONFIG_OLED_SH1106_128X64=y"
            ]
        },
        {
            "name": "esp32-phoniebox-8mb",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X64=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\""
            ]
        },
        {
            "name": "esp32-phoniebox-8mb-sh1106",
            "sdkconfig_append": [
                "CONFIG_OLED_SH1106_128X64=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\""
            ]
        }
    ]
}
